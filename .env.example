# ==========================================
# Forecast AI Environment Variables Template
# ==========================================
# Copy this file to .env or set variables in your deployment platform (Railway, Render, etc.)

# ------------------------------------------
# LLM Provider API Keys (At least one recommended)
# ------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OLLAMA_API_BASE=http://localhost:11434

# ------------------------------------------
# Kalshi & Robinhood Predict Market Data API
# ------------------------------------------
KALSHI_API_BASE_URL=https://external-api.kalshi.com/trade-api/v2
# Public market data does not require KALSHI_API_KEY.

# ------------------------------------------
# Polymarket Read-Only Market Data API
# ------------------------------------------
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API_URL=https://clob.polymarket.com

# ------------------------------------------
# Robinhood Agentic Trading MCP Execution
# ------------------------------------------
ROBINHOOD_MCP_ENDPOINT=https://agent.robinhood.com/mcp/trading

# ------------------------------------------
# Tavily API (Fact-Checking & Deep Research)
# ------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_ENABLED=false

# ------------------------------------------
# FactsAI Deep Research Integration
# ------------------------------------------
FACTSAI_API_KEY=your_factsai_api_key_here
FACTSAI_ENABLED=true

# ------------------------------------------
# API Server Configuration
# ------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=30000
SERVER_API_KEY=optional_server_api_key_here
PUBLIC_RATE_LIMIT_PER_HOUR=50
CORS_ALLOW_ORIGINS=https://your-website-domain.example
MEMORY_STORE_DIR=/data/memory
