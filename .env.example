# ==========================================
# Forecast AI Environment Variables Template
# ==========================================
# Copy this file to .env or set variables in your deployment platform (Railway, Render, etc.)

# ------------------------------------------
# LLM Provider API Keys (At least one recommended)
# ------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OLLAMA_API_BASE=http://localhost:11434

# ------------------------------------------
# Kalshi & Robinhood Predict Market Data API
# ------------------------------------------
KALSHI_API_BASE_URL=https://external-api.kalshi.com/trade-api/v2
# Public market data does not require KALSHI_API_KEY.

# ------------------------------------------
# Polymarket Read-Only Market Data API
# ------------------------------------------
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API_URL=https://clob.polymarket.com

# ------------------------------------------
# Robinhood Agentic Trading MCP Execution
# ------------------------------------------
ROBINHOOD_MCP_ENDPOINT=https://agent.robinhood.com/mcp/trading

# Robinhood Chain read-only RWA layer; proof remains disabled until the
# ForecastRegistry contract is deployed and its address is configured.
ROBINHOOD_STOCK_TOKENS_ENABLED=true
ROBINHOOD_STOCK_TOKEN_API_URL=https://api.robinhood.com/rhj
# First deployment: use Robinhood Chain testnet (46630). Switch to mainnet
# (4663) only after the commit/resolve flow and contract have been reviewed.
ROBINHOOD_CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_CHAIN_ID=4663
ROBINHOOD_CHAIN_EXPLORER_URL=https://robinhoodchain.blockscout.com
FORECAST_REGISTRY_ADDRESS=
FORECAST_PROOF_ENABLED=false
# Dedicated low-balance service wallet. Never use a personal/treasury key.
FORECAST_PUBLISHER_PRIVATE_KEY=
FORECAST_PROOF_PUBLISH_INTERVAL_SECONDS=15
FORECAST_PROOF_RESOLUTION_INTERVAL_SECONDS=300
# Durable proof outbox (server-side service role only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------
# Tavily API (Fact-Checking & Deep Research)
# ------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_ENABLED=false

# ------------------------------------------
# Mihari Robinhood Stock Token Intelligence (public / no key)
# ------------------------------------------
# Adds official corporate-action, multiplier and quote-integrity context to
# Onchain agent only when a question maps to related Robinhood Stock Tokens.
MIHARI_ENABLED=false
MIHARI_API_URL=https://mihari.pro/api/v1
MIHARI_TIMEOUT_SECONDS=12
MIHARI_MAX_SYMBOLS=5

# ------------------------------------------
# FRED Official Macro Data (free API key required)
# ------------------------------------------
# Used by the Macro agent only for macro-relevant questions such as rates,
# inflation, jobs, GDP and Treasury yields.
FRED_ENABLED=false
FRED_API_KEY=
FRED_API_URL=https://api.stlouisfed.org/fred
FRED_TIMEOUT_SECONDS=12

# ------------------------------------------
# Perigon Structured News and Event Clusters
# Routed to News and Research. Article results are cached for 15 minutes.
# ------------------------------------------
PERIGON_ENABLED=false
PERIGON_API_KEY=
PERIGON_API_URL=https://api.perigon.io
PERIGON_TIMEOUT_SECONDS=20
# A second request for story clusters. Keep false until plan cost is confirmed.
PERIGON_STORIES_ENABLED=false

# ------------------------------------------
# Exa Deep-Web Research
# ------------------------------------------
# Routed to Research. Uses Exa's documented /search API and caches results for 15 minutes.
EXA_ENABLED=false
EXA_API_KEY=
EXA_API_URL=https://api.exa.ai
EXA_TIMEOUT_SECONDS=25
# Supported modes include instant, fast, auto, deep-lite, deep and deep-reasoning.
EXA_SEARCH_TYPE=auto

# ------------------------------------------
# FactsAI Deep Research Integration
# ------------------------------------------
FACTSAI_API_KEY=your_factsai_api_key_here
FACTSAI_ENABLED=true
FACTSAI_API_URL=https://factsai.org/answer

# ------------------------------------------
# Falcon / Polymarket Analytics Intelligence
# ------------------------------------------
FALCON_API_TOKEN=your_falcon_api_token_here
FALCON_ENABLED=false
FALCON_API_URL=https://narrative.agent.heisenberg.so/api/v2/semantic/retrieve/parameterized
# Optional second paid call for Social Pulse per selected market analysis.
FALCON_SOCIAL_ENABLED=false
# Optional leaderboard + market-trades join. Enable after validating token cost.
FALCON_SMART_MONEY_ENABLED=false

# ------------------------------------------
# Bravado Trader Intelligence (Polymarket)
# ------------------------------------------
# Required for authenticated partner access. Keep this token backend-only.
BRAVADO_API_TOKEN=
BRAVADO_ENABLED=false
BRAVADO_API_URL=https://partner-api.bravadotrade.com/trader-analytics
# Recent rolling leaderboards are merged and de-duplicated before position checks.
# Bravado accepts: 1h,4h,24h,7d,30d,90d,365d,all.
BRAVADO_LEADERBOARD_WINDOW=24h,7d,30d
# Cost controls: cache is applied automatically; only this many unique non-bot wallets are scanned.
BRAVADO_SCAN_LIMIT=30
BRAVADO_MIN_TRADES=5

# ------------------------------------------
# API Server Configuration
# ------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=30000
SERVER_API_KEY=optional_server_api_key_here
PUBLIC_RATE_LIMIT_PER_HOUR=50
CORS_ALLOW_ORIGINS=https://your-website-domain.example
MEMORY_STORE_DIR=/data/memory
